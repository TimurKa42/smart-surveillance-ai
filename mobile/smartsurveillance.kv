#:kivy 2.3.0
#:import animate_press main.animate_press
#:import animate_release main.animate_release
#:import haptic_feedback main.haptic_feedback

<RoundedLabel@Label>:
    color: app.palette["text"]
    font_size: "16sp"

<SubtleLabel@Label>:
    color: app.palette["text_muted"]
    font_size: "13sp"

<AccentButton@Button>:
    scale: 1.0
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    font_size: "16sp"
    bold: True
    on_press: animate_press(self)
    on_release: animate_release(self)
    canvas.before:
        PushMatrix
        Scale:
            origin: self.center
            x: self.scale
            y: self.scale
        Color:
            rgba: app.palette["accent"] if self.state == "normal" else app.palette["accent_pressed"]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
    canvas.after:
        PopMatrix

<GhostButton@Button>:
    scale: 1.0
    accent_color: app.palette["surface_alt"]
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: app.palette["text_muted"]
    font_size: "14sp"
    on_press: animate_press(self)
    on_release: animate_release(self)
    canvas.before:
        PushMatrix
        Scale:
            origin: self.center
            x: self.scale
            y: self.scale
        Color:
            rgba: self.accent_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
    canvas.after:
        PopMatrix

<ModelButton>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: (1, 1, 1, 1) if self.is_selected else app.palette["text_muted"]
    font_size: "14sp"
    bold: self.is_selected
    on_press: animate_press(self)
    on_release: animate_release(self)
    canvas.before:
        PushMatrix
        Scale:
            origin: self.center
            x: self.scale
            y: self.scale
        Color:
            rgba: app.palette["accent"] if self.is_selected else app.palette["surface_alt"]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
    canvas.after:
        PopMatrix

<ReportItemButton>:
    # Компактний чіп ТІЛЬКИ з часом (напр. "00:00:09") - жодних довгих
    # текстів усередині списку, тому й жодного ризику "летючого"
    # переносу по літерах. Повний опис від ШІ - у панелі справа
    # (description_label), не тут.
    orientation: "horizontal"
    padding: [dp(4), dp(0)]
    on_press: animate_press(self)
    on_release: animate_release(self)
    canvas.before:
        PushMatrix
        Scale:
            origin: self.center
            x: self.scale
            y: self.scale
        Color:
            rgba: app.palette["accent"] if self.is_selected else app.palette["card"]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]
    canvas.after:
        PopMatrix

    Label:
        text: root.time_text
        color: (1, 1, 1, 1) if root.is_selected else app.palette["text"]
        font_size: "14sp"
        bold: True
        halign: "center"
        valign: "middle"
        text_size: self.width, None

<ThemeChipButton>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: (1, 1, 1, 1) if self.is_selected else app.palette["text_muted"]
    font_size: "12sp"
    bold: self.is_selected
    padding: [dp(10), 0]
    on_press: animate_press(self)
    on_release: animate_release(self)
    canvas.before:
        PushMatrix
        Scale:
            origin: self.center
            x: self.scale
            y: self.scale
        Color:
            rgba: app.palette["accent"] if self.is_selected else app.palette["surface_alt"]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(9)]
    canvas.after:
        PopMatrix

<CloseButton>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    text: ""
    on_press: animate_press(self)
    on_release: animate_release(self)
    canvas.before:
        PushMatrix
        Scale:
            origin: self.center
            x: self.scale
            y: self.scale
        Color:
            rgba: 0, 0, 0, 0.55
        Ellipse:
            pos: self.pos
            size: self.size
        Color:
            rgba: 1, 1, 1, 1
        Line:
            points: [self.x + dp(13), self.y + dp(13), self.x + self.width - dp(13), self.y + self.height - dp(13)]
            width: dp(1.6)
            cap: "round"
        Line:
            points: [self.x + dp(13), self.y + self.height - dp(13), self.x + self.width - dp(13), self.y + dp(13)]
            width: dp(1.6)
            cap: "round"
    canvas.after:
        PopMatrix
<MenuButton@Button>:
    # Окремий клас, а НЕ GhostButton з перевизначеним accent_color.
    # Причина: у GhostButton є базове правило
    # "accent_color: app.palette['surface_alt']" - воно прив'язане до
    # app.palette і перевиконується КОЖНОГО разу, коли тема
    # змінюється, затираючи будь-яке перевизначення кольору для
    # конкретного екземпляра GhostButton. Через це кнопка "Меню"
    # губила оранжевий колір саме в момент перемикання теми.
    # MenuButton взагалі не має цієї прив'язки до app.palette, тому
    # колір лишається фіксованим завжди.
    scale: 1.0
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    font_size: "14sp"
    bold: True
    on_press: animate_press(self)
    on_release: animate_release(self)
    canvas.before:
        PushMatrix
        Scale:
            origin: self.center
            x: self.scale
            y: self.scale
        Color:
            rgba: (1, 0.62, 0.28, 1) if self.state == "down" else (0.93, 0.51, 0.13, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
    canvas.after:
        PopMatrix

<TopBar@BoxLayout>:
    size_hint_y: None
    height: dp(40)

    Widget:
        size_hint_x: 1

    MenuButton:
        text: "Меню" if app.language == 'ua' else "Menu"
        size_hint_x: None
        width: dp(70)
        on_release: app.open_settings()

<SetupScreen>:
    api_key_input: api_key_input

    BoxLayout:
        orientation: "vertical"
        padding: [dp(24) + app.safe_left, dp(16) + app.safe_top, dp(24) + app.safe_right, dp(24) + app.safe_bottom]
        spacing: dp(16)
        canvas.before:
            Color:
                rgba: app.palette["bg"]
            Rectangle:
                pos: self.pos
                size: self.size

        # Убрали кнопку меню отсюда
        Widget:
            size_hint_y: 0.5

        RoundedLabel:
            text: app.language and app.t("api_key_screen_title")
            font_size: "24sp"
            bold: True
            size_hint_y: None
            height: self.texture_size[1]
            text_size: self.width, None
            halign: "center"

        SubtleLabel:
            text: app.language and app.t("api_key_screen_subtitle")
            size_hint_y: None
            height: dp(30)
            halign: "center"
            text_size: self.width, None

        Widget:
            size_hint_y: None
            height: dp(12)

        RelativeLayout:
            size_hint_y: None
            height: dp(52)

            TextInput:
                id: api_key_input
                hint_text: app.language and app.t("api_key_placeholder")
                multiline: False
                password: True
                size_hint: (1, 1)
                background_color: app.palette["surface"]
                foreground_color: app.palette["text"]
                hint_text_color: app.palette["text_muted"]
                cursor_color: app.palette["text"]
                # Увеличили отступ справа под более широкую текстовую кнопку
                padding: [dp(16), dp(14), dp(80), dp(14)]

            GhostButton:
                id: eye_btn
                text: "Показати" if app.language == 'ua' else "Show"
                font_size: "12sp"
                size_hint: (None, None)
                size: (dp(75), dp(40))
                pos_hint: {'right': 0.98, 'center_y': 0.5}
                on_release: root.toggle_password()

        GhostButton:
            text: app.language and app.t("api_key_no_key_hint")
            size_hint_y: None
            height: dp(40)
            on_release: root.open_instructions()

        RoundedLabel:
            text: root.error_text
            color: app.palette["danger"]
            font_size: "13sp"
            size_hint_y: None
            height: dp(24)

        Widget:
            size_hint_y: None
            height: dp(8)

        AccentButton:
            id: submit_btn
            text: app.language and app.t("api_key_submit")
            size_hint_y: None
            height: dp(52)
            on_release: root.submit_key()

        Widget:
            size_hint_y: 1

<MainScreen>:
    choose_gallery_btn: choose_gallery_btn
    file_label: file_label
    prompt_input: prompt_input
    word_count_label: word_count_label
    start_btn: start_btn
    model_label: model_label
    model_buttons: model_buttons
    clear_btn: clear_btn
    status_label: status_label
    report_list: report_list
    description_label: description_label
    screenshot_image: screenshot_image

    BoxLayout:
        orientation: "vertical"
        padding: [dp(14) + app.safe_left, dp(30) + app.safe_top, dp(14) + app.safe_right, dp(8) + app.safe_bottom]
        spacing: dp(8)
        canvas.before:
            Color:
                rgba: app.palette["bg"]
            Rectangle:
                pos: self.pos
                size: self.size

        TopBar

        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(6)

            AccentButton:
                id: choose_gallery_btn
                text: root.gallery_btn_text
                halign: "center"
                valign: "middle"
                font_size: "13sp"
                size_hint_x: 0.32
                text_size: self.width - dp(8), None
                on_release: root.choose_video_from_gallery()

            RoundedLabel:
                id: file_label
                color: app.palette["text_muted"]
                font_size: "12sp"
                text_size: self.width, None
                halign: "left"
                valign: "middle"
                shorten: True
                shorten_from: "left"

            GhostButton:
                id: clear_btn
                text: app.language and app.t("clear_all")
                size_hint_x: None
                width: dp(70)
                font_size: "11sp"
                on_release: root.clear_all()

        BoxLayout:
            size_hint_y: None
            height: dp(20)

            RoundedLabel:
                text: app.language and app.t("search_prompt_label")
                font_size: "12sp"
                halign: "left"
                text_size: self.width, None

            SubtleLabel:
                id: word_count_label
                size_hint_x: None
                width: dp(64)
                font_size: "11sp"
                halign: "right"
                text_size: self.width, None

        TextInput:
            id: prompt_input
            size_hint_y: None
            height: dp(38) if app.is_landscape else dp(64)
            background_color: app.palette["surface"]
            foreground_color: app.palette["text"]
            cursor_color: app.palette["text"]
            padding: [dp(14), dp(10)]
            on_text: root.update_word_count(self.text)

        AccentButton:
            id: start_btn
            text: app.language and app.t("start_analysis")
            size_hint_y: None
            height: dp(44) if app.is_landscape else dp(48)
            on_release: root.start_analysis()

        BoxLayout:
            size_hint_y: None
            height: dp(36)
            spacing: dp(8)

            RoundedLabel:
                id: model_label
                text: app.language and app.t("choose_model_label")
                font_size: "12sp"
                size_hint_x: 0.4
                halign: "left"
                text_size: self.width, None

            BoxLayout:
                id: model_buttons
                spacing: dp(6)

                ModelButton:
                    text: "3.5 Flash-Lite"
                    model_name: "gemini-3.5-flash-lite"
                    on_release: root.select_model(self.model_name)

                ModelButton:
                    text: "3.6 Flash"
                    model_name: "gemini-3.6-flash"
                    on_release: root.select_model(self.model_name)

        SubtleLabel:
            id: status_label
            size_hint_y: None
            height: dp(20)
            font_size: "12sp"
            halign: "left"
            text_size: self.width, None

        BoxLayout:
            spacing: dp(10)
            orientation: "horizontal"

            ScrollView:
                size_hint_x: 0.38 if not app.is_landscape else 0.28
                do_scroll_x: False
                BoxLayout:
                    id: report_list
                    orientation: "vertical"
                    spacing: dp(6)
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [0, 0, dp(6), 0]

            BoxLayout:
                orientation: "vertical"
                spacing: dp(6)

                RoundedLabel:
                    id: description_label
                    size_hint_y: None
                    height: dp(40)
                    font_size: "13sp"
                    halign: "left"
                    valign: "top"
                    text_size: self.width, None

                Image:
                    id: screenshot_image
                    fit_mode: "contain"
                    opacity: 0
                    canvas.before:
                        Color:
                            rgba: app.palette["surface"]
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(10)]
                    on_touch_down:
                        if self.collide_point(*args[1].pos) and self.opacity == 1: root.open_lightbox(self.source)

<SelectCheckboxIndicator@Widget>:
    # Просто ВІЗУАЛЬНИЙ індикатор вибору (не окрема кнопка) - весь
    # рядок HistoryRow і так тапабельний цілком (ButtonBehavior), тому
    # чекбоксу не потрібна власна логіка на дотик, лише малювання.
    is_selected: False
    size_hint: (None, None)
    size: (dp(26), dp(26))
    canvas.before:
        Color:
            rgba: app.palette["accent"] if self.is_selected else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(7)]
        Color:
            rgba: app.palette["accent"] if self.is_selected else app.palette["text_muted"]
        Line:
            rounded_rectangle: [self.x, self.y, self.width, self.height, dp(7)]
            width: dp(1.6)
    canvas.after:
        Color:
            rgba: 1, 1, 1, 1
        Line:
            points: [self.x + dp(6), self.y + dp(12), self.x + dp(11), self.y + dp(7), self.x + dp(20), self.y + dp(19)] if self.is_selected else []
            width: dp(2)
            cap: "round"
            joint: "round"

<HistoryRow>:
    size_hint_y: None
    height: dp(64)
    padding: [dp(14), dp(8)]
    spacing: dp(10)
    on_press: animate_press(self)
    on_release: animate_release(self)
    canvas.before:
        PushMatrix
        Scale:
            origin: self.center
            x: self.scale
            y: self.scale
        Color:
            rgba: app.palette["surface_alt"] if self.is_selected else app.palette["card"]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
    canvas.after:
        PopMatrix

    BoxLayout:
        orientation: "vertical"
        RoundedLabel:
            text: root.date_text
            bold: True
            font_size: "15sp"
            halign: "left"
            valign: "middle"
            text_size: self.width, None
        SubtleLabel:
            text: root.time_text
            halign: "left"
            valign: "middle"
            text_size: self.width, None

    SelectCheckboxIndicator:
        is_selected: root.is_selected
        opacity: 1 if root.selection_mode else 0
        size_hint_x: None
        width: dp(30) if root.selection_mode else 0

<HistoryModal>:
    size_hint: (0.86, 0.8)
    background_color: 0, 0, 0, 0.6
    pos_hint: {'center_x': 0.5, 'center_y': 0.5}

    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: app.palette["surface"]
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(20)]

        BoxLayout:
            size_hint_y: None
            height: dp(48)
            padding: [dp(12), dp(6)]
            spacing: dp(8)

            Button:
                text: "Видалити" if app.language == 'ua' else "Delete"
                background_normal: ""
                background_down: ""
                background_color: app.palette["danger"] if (root.selection_mode and root.selected_count) else app.palette["surface_alt"]
                color: (1, 1, 1, 1) if (root.selection_mode and root.selected_count) else app.palette["text_muted"]
                bold: root.selection_mode
                font_size: "14sp"
                size_hint_x: None
                width: dp(96)
                on_press: haptic_feedback()
                on_release: root.request_delete()

            SelectCheckboxIndicator:
                is_selected: root.records_count > 0 and root.selected_count == root.records_count
                opacity: 1 if root.has_records else 0.3
                disabled: not root.has_records

            Button:
                text: "все" if app.language == 'ua' else "all"
                background_normal: ""
                background_down: ""
                background_color: 0, 0, 0, 0
                color: app.palette["text_muted"]
                font_size: "13sp"
                size_hint_x: None
                width: dp(40)
                disabled: not root.has_records
                on_release: root.toggle_select_all()

            Widget:

            CloseButton:
                size_hint: (None, None)
                size: (dp(40), dp(40))
                on_release: root.dismiss()

        FloatLayout:
            ScrollView:
                do_scroll_x: False
                BoxLayout:
                    id: history_list
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [dp(12), dp(4)]
                    spacing: dp(8)

            RoundedLabel:
                text: ("Кадрів ще не знайдено" if app.language == 'ua' else "No screenshots yet")
                opacity: 0 if root.has_records else 1
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                halign: "center"
                valign: "middle"

<ConfirmModal>:
    size_hint: (0.85, None)
    height: content.height
    background_color: 0, 0, 0, 0.5
    pos_hint: {'center_x': 0.5, 'center_y': 0.5}

    BoxLayout:
        id: content
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        padding: dp(20)
        spacing: dp(16)
        canvas.before:
            Color:
                rgba: app.palette["surface"]
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(18)]

        RoundedLabel:
            text: root.message_text
            font_size: "15sp"
            halign: "center"
            valign: "middle"
            text_size: self.width, None
            size_hint_y: None
            height: max(dp(40), self.texture_size[1] + dp(8))

        BoxLayout:
            size_hint_y: None
            height: dp(46)
            spacing: dp(10)

            GhostButton:
                text: "Ні" if app.language == 'ua' else "No"
                bold: True
                on_press: haptic_feedback()
                on_release: root.dismiss()

            Button:
                text: "Так" if app.language == 'ua' else "Yes"
                background_normal: ""
                background_down: ""
                background_color: app.palette["danger"]
                color: 1, 1, 1, 1
                bold: True
                on_press: haptic_feedback()
                on_release: root.confirm()

<SettingsModal>:
    # Раніше висота шторки була фіксованою часткою екрана (0.45), і
    # якщо контент займав менше місця - зверху над "Налаштування"
    # лишалась порожня зона. Тепер висота підганяється під РЕАЛЬНИЙ
    # контент (content.height рахується як minimum_height дочірніх
    # елементів) - порожнього простору більше нема.
    size_hint: (1, None)
    height: content.height

    BoxLayout:
        id: content
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        padding: dp(20)
        spacing: dp(15)
        canvas.before:
            Color:
                rgba: app.palette["surface"]
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(20), dp(20), 0, 0]

        RelativeLayout:
            size_hint_y: None
            height: dp(40)
            RoundedLabel:
                text: "Налаштування" if app.language == 'ua' else "Settings"
                font_size: "18sp"
                bold: True
                halign: "center"
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}
            CloseButton:
                size_hint: (None, None)
                size: (dp(40), dp(40))
                pos_hint: {'right': 1, 'center_y': 0.5}
                on_release: root.dismiss()

        BoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(8)
            ThemeChipButton:
                text: "Авто" if app.language == 'ua' else "Auto"
                is_selected: app.theme_name == "auto"
                on_release: app.safe_set_theme("auto")
            ThemeChipButton:
                text: "Світла" if app.language == 'ua' else "Light"
                is_selected: app.theme_name == "light"
                on_release: app.safe_set_theme("light")
            ThemeChipButton:
                text: "Темна" if app.language == 'ua' else "Dark"
                is_selected: app.theme_name == "dark"
                on_release: app.safe_set_theme("dark")

        BoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(8)
            ThemeChipButton:
                text: "UA"
                is_selected: app.language == "ua"
                on_release: app.safe_set_language("ua")
            ThemeChipButton:
                text: "EN"
                is_selected: app.language == "en"
                on_release: app.safe_set_language("en")

        BoxLayout:
            size_hint_y: None
            height: dp(30)
            SubtleLabel:
                text: "Вібрація" if app.language == 'ua' else "Vibration"
            Switch:
                size_hint_x: None
                width: dp(70)
                active: app.vibration_enabled
                on_active: app.toggle_vibration(self.active)

        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: dp(60)
            disabled: not app.vibration_enabled
            opacity: 1 if app.vibration_enabled else 0.4
            SubtleLabel:
                text: "Сила вібрації" if app.language == 'ua' else "Vibration strength"
            Slider:
                min: 0.15
                max: 1.0
                value: app.vibration_strength
                on_value: app.save_vibration(self.value); root.test_vibrate(self, self.value)

        AccentButton:
            text: "Переглянути кадри" if app.language == 'ua' else "View screenshots"
            size_hint_y: None
            height: dp(45)
            on_release: root.open_history()

        Button:
            text: "Скинути API Ключ" if app.language == 'ua' else "Reset API Key"
            background_normal: ""
            background_down: ""
            color: 1, 1, 1, 1
            bold: True
            background_color: app.palette["danger"]
            size_hint_y: None
            height: dp(45)
            on_press: haptic_feedback()
            on_release: root.reset_app()
